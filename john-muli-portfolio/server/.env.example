# ─── Server Configuration ─────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── MongoDB ──────────────────────────────────────────────────────────────────
# Local:
MONGODB_URI=mongodb://localhost:27017/portfolio
# Atlas (recommended for production):
# MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/portfolio

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=replace-this-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=7d

# ─── Admin Account (created on first run) ─────────────────────────────────────
ADMIN_EMAIL=admin@johnmuli.dev
ADMIN_PASSWORD=ChangeThisStrongPassword123!

# ─── CORS ─────────────────────────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173

# ─── Email Notifications (optional) ──────────────────────────────────────────
# Option A: SendGrid
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxx
# Option B: SMTP (Gmail, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your-app-password
CONTACT_TO=john.muli@email.com

# ─── Cloudinary (optional — for image uploads) ────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=your_api_secret
